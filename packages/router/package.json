{
  "name": "@expressive/router",
  "version": "0.7.1",
  "description": "Host-agnostic router built on Expressive MVC components.",
  "keywords": [
    "expressive",
    "mvc",
    "router",
    "react",
    "state",
    "state-management"
  ],
  "license": "MIT",
  "author": {
    "name": "Gabe Klein",
    "email": "gabe@termtm.com",
    "url": "https://github.com/gabeklein"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabeklein/expressive-mvc.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
