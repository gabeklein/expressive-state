  },
  "devDependencies": {
    "@expressive/react": "^0.85.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsdown": "^0.20.1"
